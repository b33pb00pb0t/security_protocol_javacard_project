<?xml version="1.0" encoding="UTF-8"?>
<project name="sports-center-membership" default="build" basedir=".">
    <description>Sports Center Membership JavaCard applet build using ant-javacard</description>

    <taskdef name="javacard"
             classname="pro.javacard.ant.JavaCard"
             classpath="ant-javacard.jar"/>

    <property environment="env"/>
    <condition property="jckit.path" value="${jc.home}">
        <isset property="jc.home"/>
    </condition>
    <condition property="jckit.path" value="${env.JC_HOME}">
        <not>
            <isset property="jc.home"/>
        </not>
    </condition>

    <fail unless="jckit.path"
          message="Set -Djc.home=/path/to/javacard-sdk or export JC_HOME=/path/to/javacard-sdk before building."/>

    <path id="jc.api.path">
        <fileset dir="${jckit.path}/lib" includes="api_classic*.jar"/>
    </path>

    <path id="project.classpath">
        <path refid="jc.api.path"/>
        <fileset dir="lib" includes="*.jar"/>
    </path>

    <!-- Configurazione Percorsi -->
    <property name="src.dir" value="src"/>
    <property name="simulator.dir" value="simulator"/>
    <property name="build.dir" value="build"/>
    <property name="dist.dir" value="dist"/>
    <property name="classes.dir" value="${build.dir}/classes"/>

    <!-- Configurazione Applet e Package -->
    <property name="package.name" value="applet"/> 
    <property name="package.aid" value="A00000010203"/> <!-- AID del package (primi bytes)[cite: 8] -->
    <property name="applet.aid" value="A0000001020301"/> <!-- AID completo dell'applet[cite: 8] -->
    <property name="applet.class" value="applet.MembershipApplet"/> <!-- Deve corrispondere a src/applet/MembershipApplet.java[cite: 6, 8] -->
    <property name="cap.output" value="${dist.dir}/MembershipApplet.cap"/>

    <target name="init">
        <mkdir dir="${classes.dir}"/>
        <mkdir dir="${dist.dir}"/>
    </target>

    <target name="compile" depends="init">
        <javac destdir="${classes.dir}"
               includeantruntime="false"
               source="1.8"
               target="1.8">
            <src path="${src.dir}"/>
            <src path="${simulator.dir}"/>
            <classpath refid="project.classpath"/>
        </javac>
    </target>

    <target name="build" depends="compile">
        <javacard jckit="${jckit.path}" source="1.5" target="1.5">
            <cap aid="${package.aid}"
                 package="${package.name}"
                 version="1.0"
                 classes="${classes.dir}"
                 output="${cap.output}">
                <applet class="${applet.class}"
                        aid="${applet.aid}"/>
            </cap>
        </javacard>
    </target>

    <target name="run-simulator" depends="compile">
        <java classname="RunMembershipSimulator" fork="true">
            <classpath>
                <path refid="project.classpath"/>
                <pathelement location="${classes.dir}"/>
            </classpath>
        </java>
    </target>

    <target name="clean">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>
</project>