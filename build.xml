<project name="SportsCenter" default="build-cap" basedir=".">
    
    <taskdef name="javacard" classname="pro.javacard.ant.JavaCard" 
         classpath="${basedir}/lib/ant-javacard.jar"/>

    <target name="clean">
        <delete dir="build"/>
    </target>

    <target name="init">
        <mkdir dir="build/classes-card"/>
        <mkdir dir="build/cap"/>
    </target>

    <target name="build-cap" depends="init">
        <javac srcdir="src" destdir="build/classes-card" source="1.3" target="1.2" includeantruntime="false">
            <include name="applet/**"/>
            <exclude name="terminals/**"/>
            <exclude name="backend/**"/>
            <classpath>
                <pathelement location="util/java_card_kit-2_2_1/lib/api.jar"/>
            </classpath>
        </javac>
        
        <javacard jckit="util/java_card_kit-2_2_1">
            <cap aid="A000000001020301" package="applet" output="build/cap/applet.cap" classes="build/classes-card">
                <applet class="applet.MembershipApplet" aid="A000000001020302"/>
            </cap>
        </javacard>
        <echo message="Build successful: .cap file generated."/>
    </target>

    <target name="build-host">
        <mkdir dir="build/classes-host"/>
        <javac srcdir="src" destdir="build/classes-host" includeantruntime="false">
            <classpath>
                <pathelement location="util/java_card_kit-2_2_1/lib/api.jar"/>
                <fileset dir="lib">
                    <include name="*.jar"/>
                </fileset>
            </classpath>
        </javac>
        <echo message="Frontend and Terminal compiled successfully."/>
    </target>

</project>